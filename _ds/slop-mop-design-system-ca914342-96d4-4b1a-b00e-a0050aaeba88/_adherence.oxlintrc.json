{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/core/**",
              "components/verdict/**",
              "ui_kits/extension/**",
              "ui_kits/feed/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|warn|danger|clean|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'warn' | 'danger' | 'clean' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|disabled|fullWidth|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, disabled, fullWidth, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|solid|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'solid' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|tone|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, action, tone, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|sunken)$/]",
        "message": "<Card> tone must be one of 'paper' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FoldStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|reasons|score|onRestore|restored|style|key|ref|className|style|children)$/]",
        "message": "<FoldStrip> doesn't accept that prop. Declared props: label, reasons, score, onRestore, restored, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|label|children|style|key|ref|className|style|children)$/]",
        "message": "<HighlightFrame> doesn't accept that prop. Declared props: level, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightFrame'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:warn|danger)$/]",
        "message": "<HighlightFrame> level must be one of 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|active|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, active, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MopMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|knockout|style|key|ref|className|style|children)$/]",
        "message": "<MopMark> doesn't accept that prop. Declared props: size, knockout, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SensitivitySlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|showThreshold|disabled|style|key|ref|className|style|children)$/]",
        "message": "<SensitivitySlider> doesn't accept that prop. Declared props: value, onChange, showThreshold, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SensitivitySlider'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:mild|moderate|aggressive)$/]",
        "message": "<SensitivitySlider> value must be one of 'mild' | 'moderate' | 'aggressive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatsDial'] > JSXAttribute > JSXIdentifier[name!=/^(?:today|record|size|caption|style|key|ref|className|style|children)$/]",
        "message": "<StatsDial> doesn't accept that prop. Declared props: today, record, size, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, sub, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|warn|danger)$/]",
        "message": "<StatTile> tone must be one of 'neutral' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|description|size|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, description, size, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Switch> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhyTell'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|key|ref|className|style|children)$/]",
        "message": "<WhyTell> doesn't accept that prop. Declared props: name, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|showDot|showMark|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, showDot, showMark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'inverse'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
